{
  "name": "mimir-monorepo",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b packages/mimir && pnpm --filter dsh-mimir run bundle && tsc -b packages/ui-mimir && pnpm --filter dsh-client-ui-mimir run bundle && pnpm --filter dsh-mimir run bundle:client",
    "typecheck": "tsc -b packages/mimir packages/ui-mimir",
    "check-style": "node scripts/check-style.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bundle": "pnpm -r run bundle"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.2-alpha.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
